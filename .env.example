# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Tajný kľúč – NIKDY nedávať do kódu ani do prehliadača.
SUPABASE_SERVICE_ROLE_KEY=

# --- Emaily (Resend) ---
RESEND_API_KEY=
# Odosielateľ – doména musí byť overená v Resend (DNS záznamy).
ORDER_FROM_EMAIL="VITAPRO <objednavky@vita-pro.sk>"

# --- Web ---
# Verejná adresa webu (pre odkazy v emailoch). Lokálne http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Ochrana proti botom (Cloudflare Turnstile) – voliteľné ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Vyhľadávače ---
# Kým web nie je ostro spustený, nechať prázdne (web sa neindexuje). Pri spustení nastaviť na true.
ALLOW_INDEXING=
